# dsb 中继的本机配置样板: 复制成 .env 再改. .env 不进版本库, 这份样板进.
# 下面写的都是缺省值, 不填照走; 进程环境变量优先于 .env.
# 解析口径见 dsb/config.py 与 dsb/gateway.py, 对拍在 protocol/fixtures/config.json.

# 监听端口(MCP 端点落在这儿).
DSB_PORT=8787

# 一次 tools/call 等子进程的时限(秒).
DSB_TOOL_TIMEOUT=120

# 起子进程 + 握手(initialize)的时限(秒): npx 首次下载可能拖.
DSB_CONNECT_TIMEOUT=30

# tools/list 的时限(秒): 发现一次就够.
DSB_DISCOVERY_TIMEOUT=20

# 工作文件夹 root(五件工作工具的活动范围; 缺省本仓根). 要放开就填绝对路径:
# DSB_WORK_ROOT=/Users/you/workspace

# mcp.json 的落点(缺省本仓根; 这份配置同样不进版本库). 要在别处放就填绝对路径:
# DSB_MCP_CONFIG=/Users/you/.config/ds-/mcp.json

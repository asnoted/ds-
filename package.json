{
  "name": "ds-",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "check": "dsh --profile web --dump-config",
    "build": "pnpm --filter dsh-dsb --filter dsh-dsweb pack --pack-destination dist",
    "deploy:plugins": "pnpm build && dsh plugin --profile web add --force ./dist/dsh-dsb-0.1.0.tgz ./dist/dsh-dsweb-0.1.0.tgz",
    "smoke": "node scripts/smoke-web.mjs",
    "repomix": "npx repomix",
    "wire": "dsh plugin --profile web add file:./dsweb file:./dsb"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}

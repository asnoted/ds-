{
  "name": "dsb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:plugins": "pnpm --filter dsh-dsb --filter dsh-dsweb test",
    "smoke:web": "node scripts/smoke-web.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "package:plugins": "pnpm --filter dsh-dsb --filter dsh-dsweb pack --pack-destination dist",
    "deploy:plugins": "pnpm package:plugins && dsh plugin --profile web remove dsh-dsb dsh-dsweb; dsh plugin --profile web add ./dist/dsh-dsb-0.1.0.tgz ./dist/dsh-dsweb-0.1.0.tgz && node scripts/verify-deploy.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}

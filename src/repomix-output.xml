function toggleApi(initial = false): ToggleApi & { value: boolean; sets: number } {
  const api = {
    value: initial,
    sets: 0,
    async get(): Promise<boolean> {
      return api.value;
    },
    async set(value: boolean): Promise<boolean> {
      api.value = value;
      api.sets += 1;
      return api.value;
    },
  };
  return api;
}

function storageApi(): StorageApi & {
  stored: Record<string, unknown>;
  gets: number;
  sets: number;
  removes: number;
} {
  const api = {
    stored: {} as Record<string, unknown>,
    gets: 0,
    sets: 0,
    removes: 0,
    async get(keys: readonly string[]): Promise<Record<string, unknown>> {
      api.gets += 1;
      const out: Record<string, unknown> = {};
      for (const key of keys) if (key in api.stored) out[key] = api.stored[key];
      return out;
    },
    async set(data: Record<string, unknown>): Promise<void> {
      api.sets += 1;
      api.stored = { ...api.stored, ...data };
    },
    async remove(keys: readonly string[]): Promise<void> {
      api.removes += 1;
      for (const key of keys) delete api.stored[key];
    },
  };
  return api;
}

describe("storage.get / storage.set / storage.remove", () => {

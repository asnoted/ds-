      ok: false,
      error: "backing-off",
    });
    expect(sent.map((f) => f.action)).toEqual(["page.state"]);
  });

  it("think.set / search.set 也在退避闸下(改页面状态是写),think.get 不受影响", async () => {
    const { send, sent } = recordingSendToTab(MUTED);

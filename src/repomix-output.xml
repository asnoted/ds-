describe("圆键:此刻是什么意图", () => {
  // 真机抓的原件(ADR-0006 存证):两态 class 一个不换,只有圆键里的图标不同--
  // **所以那不是两个控件,是一个**:它此刻是发送还是停止是页面的意图,不是控件的身份.
  const STOP_HTML = evidenceHtml("circle.stop");
  const SEND_HTML = evidenceHtml("circle.send");

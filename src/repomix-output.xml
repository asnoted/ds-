  });
});

describe("afterHealthProbe / 周期探活 → 状态位", () => {
  it("总开关关着:探到什么一律原样,不上屏", () => {
    expect(afterHealthProbe("off", true)).toEqual({ state: "off", notice: null });
    expect(afterHealthProbe("off", false)).toEqual({ state: "off", notice: null });
  });

  it("可达就翻回绿,清掉原因", () => {
